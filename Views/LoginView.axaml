<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:Loudspeaker.ViewModels"
             x:Class="Loudspeaker.Views.LoginView"
             x:DataType="viewModels:LoginViewModel"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="300">
    <Grid RowDefinitions="*,Auto,*" ColumnDefinitions="*,Auto,*" Margin="20">
        <Border Grid.Row="1" Grid.Column="1" 
                Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                CornerRadius="8"
                Padding="30"
                BoxShadow="0 2 8 0 #40000000">
            <StackPanel Spacing="20" MinWidth="300">
                <TextBlock Text="Welcome to Loudspeaker" 
                          FontSize="24" 
                          FontWeight="Bold"
                          HorizontalAlignment="Center"
                          Margin="0,0,0,10"/>
                
                <TextBlock Text="Sign in with your Google account to continue" 
                          FontSize="14"
                          Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                          HorizontalAlignment="Center"
                          TextWrapping="Wrap"
                          Margin="0,0,0,20"/>
                
                <Button Content="Sign in with Google" 
                       Command="{Binding SignInCommand}"
                       IsEnabled="{Binding !IsLoading}"
                       HorizontalAlignment="Stretch"
                       Height="40"
                       FontSize="14"/>
                
                <ProgressBar IsIndeterminate="True" 
                            IsVisible="{Binding IsLoading}"
                            Height="4"
                            Margin="0,10,0,0"/>
                
                <Border IsVisible="{Binding HasError}"
                        Background="#FFF5F5F5"
                        BorderBrush="Red"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="10"
                        Margin="0,10,0,0"
                        MaxHeight="200">
                    <StackPanel Spacing="5">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Auto"
                                      MaxHeight="150">
                            <TextBlock Text="{Binding ErrorMessage}" 
                                      Foreground="Red"
                                      TextWrapping="Wrap"
                                      FontFamily="Consolas, Courier New, monospace"
                                      FontSize="11"/>
                        </ScrollViewer>
                        <Button Content="Open Log File Location" 
                               Command="{Binding OpenLogFileCommand}"
                               HorizontalAlignment="Right"
                               FontSize="11"
                               Padding="8,4"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

